# ==========================================
# SupportFlow AI - Environment Configuration
# ==========================================

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Security
API_KEY=dev-supportflow-api-key-change-me
WEBHOOK_SECRET=dev-supportflow-hmac-secret-change-me

# PostgreSQL Database (with pgvector)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/supportflow
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=supportflow

# Google Gemini LLM & Embeddings
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# HubSpot Integration
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# n8n Orchestration
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_ENCRYPTION_KEY=generate-a-strong-random-key-for-n8n
WEBHOOK_URL=http://localhost:5678/

# Streamlit Dashboard
DASHBOARD_PASSWORD=admin
API_BASE_URL=http://localhost:8000/api/v1
